# Node runtime environment. One of: development | test | production
NODE_ENV=development

# TCP port the MCP server binds to. Local dev uses 4001 because the dashboard
# owns port 3000 and the api uses 4000; without this override, `pnpm dev` at
# the repo root would collide on 3000. In production (Fly) the PaaS injects
# its own PORT, so this value is a local-dev convenience only.
PORT=4001

# Host/interface to bind. Use 0.0.0.0 inside containers; 127.0.0.1 locally if desired.
HOST=0.0.0.0

# Pino log level. One of: debug | info | warn | error
LOG_LEVEL=info

# HMAC-SHA256 salt used to derive project_api_tokens.token_hash from the
# plaintext bearer. Must be IDENTICAL to the salt apps/api uses when it creates
# tokens (task 2.20) — otherwise the hash won't match and every request 401s.
# Generate with: openssl rand -hex 32
TOKEN_HASH_SALT=replace_me_with_a_high_entropy_secret

# Shared secret sent as `X-Internal-Auth` on every MCP→API call. The API's
# internal scope (task 2.5) refuses any request without it. Same value must be
# set in apps/api when 2.5 lands. Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=replace_me_with_a_high_entropy_secret

# Base URL of the Remarks API. On Fly: http://remarks-api.internal:3000
# (private VPC, no TLS). Locally: http://localhost:4000.
API_INTERNAL_URL=http://localhost:4000

# Upstash Redis REST endpoint + token. Find both in the Upstash dashboard
# under your database → REST API. The MCP auth plugin uses this to cache
# token-resolution results for 5 min (Phase 2 spec §5.4).
UPSTASH_REDIS_REST_URL=https://replace-me.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_me
