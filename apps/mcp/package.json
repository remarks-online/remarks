{
  "name": "@remarks/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "biome check src",
    "test": "vitest run"
  },
  "dependencies": {
    "@clerk/backend": "^3.2.14",
    "@fastify/sensible": "^6.0.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@remarks/mcp-schema": "workspace:*",
    "@remarks/shared": "workspace:*",
    "@upstash/redis": "^1.34.7",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
