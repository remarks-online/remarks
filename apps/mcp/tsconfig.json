{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // The mcp app's dist/ is consumed only by `node dist/index.js`; nothing
    // imports its types externally (no package "exports" map). Declarations
    // are pure ship-weight, so disable them.
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts"]
}
