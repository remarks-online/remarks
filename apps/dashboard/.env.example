# Node runtime environment. One of: development | test | production
NODE_ENV=development

# Clerk — get from the Clerk dashboard (Developers -> API keys).
# Local dev and preview deploys use the `remarks-dev` instance (pk_test_*, sk_test_*).
# Production (Vercel `Production` scope) uses the `remarks-prod` instance (pk_live_*, sk_live_*).
# Server-side secret; never ship to the browser.
CLERK_SECRET_KEY=sk_test_replace_me
# Public publishable key; safe to expose in the browser bundle.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Base URL of the Fastify API, used by the dashboard's tRPC client both server-side
# (RSC caller in src/lib/trpc-server.ts) and client-side (TRPCProvider). Local dev:
# the api defaults to PORT=4000 (see apps/api/.env.example). Production: set to the
# deployed Fly app URL (e.g. https://api.remarks.online).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# PostHog browser SDK (spec §7.5 product analytics). Optional — when unset,
# the dashboard's analytics helper no-ops so dev/preview deploys work without
# a project key. Set in Vercel Production to the `remarks` project key (find
# it in PostHog → Project Settings → "Project API Key", project id 392713).
# NEXT_PUBLIC_POSTHOG_KEY=phc_replace_me
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Extension ID for chrome.runtime.sendMessage install detection from the
# onboarding wizard. Default is the load-unpacked dev ID pinned by the
# committed manifest key (spec-gaps A8). Override in Vercel Production once
# the Chrome Web Store assigns a final ID.
NEXT_PUBLIC_EXTENSION_ID=baikikfefeheiildmfoaicbjbnbecgjd

# Chrome Web Store listing URL for the wizard's "Add to Chrome" CTA. Leave
# unset until the extension is submitted (§15); the wizard falls back to
# load-unpacked instructions in the meantime.
# NEXT_PUBLIC_CHROME_WEB_STORE_URL=https://chrome.google.com/webstore/detail/...

# Public URL of the hosted MCP server. Rendered into the "Connect Agent"
# guide page (project settings) — install commands and config snippets
# point here. Local dev: http://localhost:4001/mcp.
# Production: https://mcp.remarks.dev/mcp.
NEXT_PUBLIC_MCP_SERVER_URL=http://localhost:4001/mcp
