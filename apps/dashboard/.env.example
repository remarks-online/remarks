# Node runtime environment. One of: development | test | production
NODE_ENV=development

# Clerk — get from the Clerk dashboard (Developers -> API keys).
# Local dev and preview deploys use the `remarks-dev` instance (pk_test_*, sk_test_*).
# Production (Vercel `Production` scope) uses the `remarks-prod` instance (pk_live_*, sk_live_*).
# Server-side secret; never ship to the browser.
CLERK_SECRET_KEY=sk_test_replace_me
# Public publishable key; safe to expose in the browser bundle.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Base URL of the Fastify API, used by the dashboard's tRPC client both server-side
# (RSC caller in src/lib/trpc-server.ts) and client-side (TRPCProvider). Local dev:
# the api defaults to PORT=4000 (see apps/api/.env.example). Production: set to the
# deployed Fly app URL (e.g. https://api.remarks.online).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
