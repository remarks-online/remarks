{
  "name": "@remarks/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    "./trpc/router": "./src/trpc/router.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "biome check src scripts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check-fly-secrets": "tsx scripts/check-fly-secrets.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1035.0",
    "@aws-sdk/s3-request-presigner": "^3.1035.0",
    "@clerk/backend": "^3.2.14",
    "@fastify/cors": "^11.2.0",
    "@fastify/sensible": "^6.0.3",
    "@remarks/db": "workspace:*",
    "@remarks/shared": "workspace:*",
    "@trpc/server": "^11.0.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "svix": "^1.40.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
