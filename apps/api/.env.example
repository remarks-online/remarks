# Node runtime environment. One of: development | test | production
NODE_ENV=development

# TCP port the Fastify server binds to.
PORT=3000

# Host/interface to bind. Use 0.0.0.0 inside containers; 127.0.0.1 locally if desired.
HOST=0.0.0.0

# Pino log level. One of: debug | info | warn | error
LOG_LEVEL=info

# Postgres connection string (Neon). Use the direct (non-pooled) endpoint locally
# and the pooled endpoint in production; the Drizzle client disables server-side
# prepared statements to accommodate Neon's pgbouncer.
DATABASE_URL=postgres://user:password@localhost:5432/remarks_dev

# Clerk webhook signing secret, used to verify Svix signatures on POST /webhooks/clerk.
# Find this in the Clerk dashboard under Webhooks → endpoint → Signing Secret.
CLERK_WEBHOOK_SECRET=whsec_replace_me
