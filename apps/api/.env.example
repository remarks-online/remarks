# Node runtime environment. One of: development | test | production
NODE_ENV=development

# TCP port the Fastify server binds to. Local dev uses 4000 because the dashboard
# owns port 3000 (hardcoded in `next dev -p 3000`) and mcp uses 4001; without this
# override, `pnpm dev` at the repo root would collide on 3000. In production (Fly)
# the PaaS injects its own PORT, so this value is a local-dev convenience only.
PORT=4000

# Host/interface to bind. Use 0.0.0.0 inside containers; 127.0.0.1 locally if desired.
HOST=0.0.0.0

# Pino log level. One of: debug | info | warn | error
LOG_LEVEL=info

# Postgres connection string (Neon). Use the direct (non-pooled) endpoint locally
# and the pooled endpoint in production; the Drizzle client disables server-side
# prepared statements to accommodate Neon's pgbouncer.
DATABASE_URL=postgres://user:password@localhost:5432/remarks_dev

# Clerk webhook signing secret, used to verify Svix signatures on POST /webhooks/clerk.
# Find this in the Clerk dashboard under Webhooks → endpoint → Signing Secret.
CLERK_WEBHOOK_SECRET=whsec_replace_me

# Clerk backend API secret key, used by @clerk/backend to verify Bearer JWTs on
# authenticated requests and to fetch org memberships. Distinct from the webhook
# secret above. Find this in the Clerk dashboard under API Keys → Secret key.
CLERK_SECRET_KEY=sk_replace_me

# Cloudflare R2 credentials for screenshot storage (ADR 0012). Find the account
# ID in the Cloudflare dashboard sidebar; generate an access-key pair under
# R2 → Manage R2 API Tokens with read+write on the bucket below.
R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me

# Bucket name for screenshots. Use `remarks-screenshots-dev` locally/preview and
# `remarks-screenshots-prod` in production (both provisioned in Phase 0).
R2_BUCKET_SCREENSHOTS=remarks-screenshots-dev

# Optional: override the S3 endpoint for local/CI integration tests against
# MinIO. Leave unset in production — the R2 endpoint is derived from
# R2_ACCOUNT_ID. Uncomment when running MinIO via `pnpm minio:up` (see
# compose.yml at the repo root). The default MinIO creds (minioadmin /
# minioadmin) are auto-supplied by apps/api/test/integration/setup.ts.
# R2_S3_ENDPOINT=http://localhost:9000

# PostHog server SDK key (spec §7.5 product analytics). Optional — when unset,
# the API's posthog helper no-ops so dev/CI without a project key works
# unchanged. Set in Fly secrets for production. Same project as the dashboard
# (project id 392713 — see PostHog → Project Settings → "Project API Key").
# POSTHOG_PROJECT_API_KEY=phc_replace_me
POSTHOG_HOST=https://us.i.posthog.com
