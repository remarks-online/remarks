# Clerk publishable key for the extension popup (dev instance).
# Obtain from https://dashboard.clerk.com → your app → API keys.
WXT_CLERK_PUBLISHABLE_KEY=pk_test_

# Base URL of the Remarks API. For local dev, the Fastify app from apps/api,
# which binds to PORT=4000 per apps/api/.env.example.
WXT_API_URL=http://localhost:4000

# Origin the extension pulls its Clerk session cookie from (syncHost).
# IMPORTANT: this is the COOKIE-SYNC origin only — not the destination for
# sign-in / dashboard navigation (those use WXT_DASHBOARD_URL below). dev
# and prod read from different hosts because Clerk sets the session cookie
# in different places depending on instance type:
#   - dev (`pk_test_…`): dashboard origin (http://localhost:3000) — Clerk
#     stamps a dev-browser-token cookie there
#   - prod (`pk_live_…`): the **Clerk Frontend API** domain
#     (https://clerk.remarks.online) — that's where `__client` lives
# Per https://clerk.com/docs/chrome-extension/getting-started/quickstart and
# the @clerk/chrome-extension SDK at chunk-SYSWCRXO.js (see CLIENT_JWT_KEY).
# The chrome-extension://<id> that corresponds to manifest.key must also be
# in the Clerk instance's allowed_origins — see
# tools/scripts/clerk-allowlist-extension.ts.
WXT_CLERK_SYNC_HOST=http://localhost:3000

# Dashboard origin used for every "open a tab to the dashboard" redirect
# (sign-in, sign-up, project create, the more-menu fallback). Kept separate
# from WXT_CLERK_SYNC_HOST because in prod they diverge — syncHost is the
# Clerk FAPI (clerk.remarks.online), the dashboard is app.remarks.online.
WXT_DASHBOARD_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Production builds (`pnpm --filter @remarks/extension build:prod`)
# ---------------------------------------------------------------------------
# `build:prod` passes `--mode production` to wxt, which makes Vite layer
# `.env.production` on top of `.env`. Create `apps/extension/.env.production`
# locally (it is gitignored alongside every other .env file) with the prod
# Clerk + dashboard + API URLs:
#
#   WXT_CLERK_PUBLISHABLE_KEY=pk_live_…   # remarks-prod publishable key
#   WXT_API_URL=https://api.remarks.online
#   WXT_CLERK_SYNC_HOST=https://clerk.remarks.online   # FAPI cookie sync only
#   WXT_DASHBOARD_URL=https://app.remarks.online       # sign-in + dashboard tabs
#
# After rotating to prod values, allowlist the deterministic extension origin
# on the prod Clerk instance ONCE (idempotent):
#
#   CLERK_SECRET_KEY=sk_live_… pnpm --filter @remarks/scripts exec tsx \
#     ../../tools/scripts/clerk-allowlist-extension.ts \
#     baikikfefeheiildmfoaicbjbnbecgjd
#
# (The same extension ID applies to prod and dev — manifest.key in
# wxt.config.ts pins it across all installs.)
