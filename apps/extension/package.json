{
  "name": "@remarks/extension",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "node scripts/prepare-with-exit.cjs build",
    "build:prod": "pnpm turbo run build --filter='@remarks/extension^...' && node scripts/prepare-with-exit.cjs build --mode production",
    "build:firefox": "node scripts/prepare-with-exit.cjs build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "node scripts/prepare-with-exit.cjs prepare && tsc --noEmit",
    "lint": "biome check src e2e",
    "test": "vitest run",
    "test:e2e": "pnpm turbo run build --filter=@remarks/extension && playwright test --config e2e/playwright.config.ts",
    "verify:auth": "node scripts/prepare-with-exit.cjs build && playwright test --config verify/playwright.config.ts verify/auth-flow.spec.ts",
    "verify:screenshot": "node scripts/prepare-with-exit.cjs build && playwright test --config verify/playwright.config.ts verify/screenshot-preview.spec.ts",
    "verify": "node scripts/prepare-with-exit.cjs build && playwright test --config verify/playwright.config.ts",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@clerk/chrome-extension": "^3.1.0",
    "@remarks/shared": "workspace:*",
    "@remarks/ui": "workspace:*",
    "@tanstack/react-query": "^5.62.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "lucide-react": "^0.468.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwindcss": "^4.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.59.1",
    "@remarks/api": "workspace:*",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/chrome": "^0.1.40",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^22.10.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@wxt-dev/module-react": "^1.1.3",
    "dotenv": "^17.4.2",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^29.0.2",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4",
    "wxt": "^0.20.0"
  }
}
