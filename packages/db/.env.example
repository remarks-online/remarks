# Connection string for the Neon dev branch (or a local Docker Postgres for offline work).
# Use the pooled endpoint (-pooler) for app runtime; the direct endpoint is fine for drizzle-kit.
DATABASE_URL=postgresql://user:password@host.neon.tech/remarks_dev?sslmode=require

# Optional: set to "1" to log every Drizzle query.
DB_LOG=
