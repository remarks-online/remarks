# Connection string used by drizzle-kit (db:generate, db:migrate, db:studio) only.
# The app runtime reads DATABASE_URL from its own env file — not this one.
#
# Use the Neon *direct* (non-pooler) endpoint for the dev branch: pgbouncer (pooler)
# breaks drizzle-kit's migration transactions. Copy from Neon console → dev branch →
# Connection string → uncheck "Connection pooling".
#
# For production migrations, run `pnpm --filter @remarks/db db:migrate` from CI or
# an ops machine with DATABASE_URL pointing at the Neon main direct endpoint.
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# Optional: set to "1" to log every Drizzle query.
DB_LOG=
